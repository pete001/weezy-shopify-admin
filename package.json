{
  "name": "weezy-shopify-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "extensions/*"
  ],
  "scripts": {
    "build": "shopify app build",
    "deploy": "shopify app deploy",
    "dev": "shopify app dev",
    "test": "node --test tests/*.test.mjs contracts/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "node qa/preview.mjs",
    "verify": "npm test && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@remote-dom/polyfill": "^1.6.0",
    "@shopify/cli": "4.9.4",
    "esbuild": "^0.28.2",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "@shopify/ui-extensions": "2026.10.0",
    "preact": "11.0.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
